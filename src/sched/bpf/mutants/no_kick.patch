# no_kick: a policy the contracts must reject.
#
# Claim an idle CPU through the kernel's search but never kick it.
#
# The search clears the CPU's idle bit, so no later enqueue can find it,
# and nothing wakes it: the task filed on its queue waits until something
# else happens to run there. The automaton demands a `Kick` of the claimed
# CPU before anything else is asked of it.
#
--- bpf/main.rs
+++ bpf/main.rs
@@ -214,8 +214,6 @@
             scx::dsq_insert_vtime(&p, cpu as u64, SCX_SLICE_DFL, vtime, enq_flags, log);
             return;
         }
-        // Claimed, so kicked, before anything else is asked of it.
-        scx::kick_cpu(target, SCX_KICK_IDLE, log);
         // Ours if it has a queue, its queue is empty and its word goes
         // from free to promised. A CPU beyond the queues cannot come back
         // from the search after a successful `init`; it is kicked all the
